# Nebius Token Factory (OpenAI-compatible). Create a key at tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Confirm exact IDs with: python -m redcell.scripts.list_models  (GET /v1/models)
REDCELL_PLANNER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
REDCELL_TARGET_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
REDCELL_JUDGE_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Hard spend cap per run, in USD. RedCell stops when it is reached.
REDCELL_BUDGET_USD=1.50

# Tavily threat intel (optional). Create a key at app.tavily.com. Without it, RedCell
# simply skips the intel step (offline), like the Nemotron mock path - no crash.
TAVILY_API_KEY=

# LangSmith tracing (optional; a third-party observability tool, not part of Nebius/NVIDIA). Off unless the
# langsmith package is installed (pip install langsmith), LANGSMITH_API_KEY is set AND LANGSMITH_TRACING=true.
# Use a tracing-only key. Traces never include API keys, headers or the judge run code.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=redcell
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
